func get_tier(enemy_id: String) -> int:
	if not GlobalSave.is_seen(enemy_id): return 0
	var obs_key: String = OBSERVE_KEY.get(enemy_id, enemy_id)
	var t: float = GlobalSave.get_observe_time(obs_key)
	if t >= 45.0: return 4
	if t >= 15.0: return 3
	if t >= 3.0:  return 2
	return 1


func get_entry(enemy_id: String) -> Dictionary:
	for e in ENEMY_DATA:
		if e["id"] == enemy_id: return e
	return {}
